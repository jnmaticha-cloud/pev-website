# Copy this file to .env and fill in real values before deploying.
# Never commit the actual .env file — it's already in .gitignore.

# --- Required in production ---
NODE_ENV=production
# Long, random secret used to sign login tokens. The app refuses to start
# in production without a real one set here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Network ---
PORT=3000
# Comma-separated list of origins allowed to call the API (your real
# domain(s)). Leave blank only for local development.
ALLOWED_ORIGINS=https://www.primeeliteventures.com

# --- Outbound email (approvals, notifications, contact form) ---
# Leave SMTP_HOST blank to disable real email sending — the app logs
# messages instead of sending them, which is fine for local testing but
# NOT for production (approval emails etc. would silently never arrive).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Prime Elite Ventures <no-reply@primeeliteventures.com>

# --- Optional: external business-news feed for the homepage "At a
# glance" strip. Get a free key from https://gnews.io — leave blank to
# skip that feature entirely (it degrades gracefully either way).
NEWS_API_KEY=
