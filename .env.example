# Server configuration
PORT=3000
NODE_ENV=production

# JWT Authentication secret (Required in production)
JWT_SECRET=your_random_secure_jwt_secret_here

# Allowed origins for CORS (comma-separated, optional)
# ALLOWED_ORIGINS=https://your-site.onrender.com

# SMTP configuration for email notifications (optional - logs to console if omitted)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=secret
# SMTP_FROM="Prime Elite Ventures" <notifications@primeeliteventures.example>
